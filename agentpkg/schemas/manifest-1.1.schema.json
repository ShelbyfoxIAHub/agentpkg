{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ShelbyfoxIAHub/agentpkg/schemas/manifest-1.1.schema.json",
  "title": "agentpkg manifest 1.1",
  "type": "object",
  "required": ["spec_version", "name"],
  "properties": {
    "spec_version": {"type": "string", "pattern": "^1\\.[0-9]+$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]*$"},
    "description": {"$ref": "#/$defs/text"},
    "author": {"type": "string", "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]*$"},
    "created_at": {"type": "string", "maxLength": 64},
    "data_summary": {
      "type": "object",
      "properties": {
        "file_count": {"type": "integer", "minimum": 0},
        "total_size_bytes": {"type": "integer", "minimum": 0},
        "primary_languages": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/label"}},
        "categories": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/label"}}
      }
    },
    "files": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"$ref": "#/$defs/path"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "media_type": {"type": "string", "maxLength": 255},
          "category": {"$ref": "#/$defs/label"},
          "language": {"$ref": "#/$defs/label"}
        }
      }
    },
    "capabilities": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/label"}},
    "dependencies": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["kind", "name"],
        "properties": {
          "kind": {"type": "string", "enum": ["plugin", "python", "mcp", "tool"]},
          "name": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
          "version": {"type": "string", "maxLength": 64, "pattern": "^[^\\u0000-\\u001f\\u007f]*$"},
          "optional": {"type": "boolean"}
        }
      }
    },
    "entry_points": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["path", "role"],
        "properties": {
          "path": {"$ref": "#/$defs/path"},
          "role": {"$ref": "#/$defs/label"},
          "description": {"type": "string", "maxLength": 1000}
        }
      }
    },
    "skills": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["name", "path"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
          "description": {"type": "string", "maxLength": 1000},
          "path": {"$ref": "#/$defs/path"},
          "command": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 1024, "pattern": "^[^\\u0000]*$"}}
        }
      }
    }
  },
  "$defs": {
    "label": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9._:+-]*$"},
    "text": {"type": "string", "maxLength": 100000, "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(data|index)/[^\\\\:\\u0000-\\u001f]+$"}
  }
}
